# ╔══════════════════════════════════════════════════════════╗
# ║  SEEKOP Vacaciones — Backend Environment Variables      ║
# ║                                                          ║
# ║  Copy this file to .env and fill in the values.          ║
# ║  NEVER commit .env to the repository.                    ║
# ╚══════════════════════════════════════════════════════════╝

# ─── App ─────────────────────────────────────────────
APP_NAME=Vacation Control API
APP_ENV=dev                          # dev | production
APP_DEBUG=true                       # false in production
API_V1_PREFIX=/api/v1

# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://vacation_user:vacation_pass@localhost:5432/vacation_db
DB_POOL_SIZE=5                       # 10-20 for production
DB_MAX_OVERFLOW=10                   # 20 for production
DB_POOL_TIMEOUT=30

# ─── Auth (CRITICAL: change JWT_SECRET_KEY in production!) ─
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── CORS ────────────────────────────────────────────
# In production, set to your actual frontend domain(s)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_FRONTEND_URL=http://localhost:3001

# ─── LLM (opcional) ─────────────────────────────────
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ─── SMTP (opcional — para emails de bienvenida y recuperación) ─
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=SEEKOP Vacaciones
SMTP_FROM_EMAIL=

# ─── Storage / Uploads ──────────────────────────────
STORAGE_BACKEND=local                # local | s3
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ─── Jira Integration (opcional) ─────────────────────
JIRA_BASE_URL=
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
